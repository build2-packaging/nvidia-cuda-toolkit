define archive: file
archive{*}: extension = tar

define extract: group

# build2 already knows about libi on Windows.
if ($cc.target.class != 'windows')
{
  define libi: file
}

# Fetch NVIDIA redistrib JSON.
# $<[0]: build2 package manifest, $<[1]: manifest.json (local config)
json{~'/(.+-manifest.*)/'}:
{{
  local_cfg  = [json] $json.load($path($<[1]))
  redistUrl  = [string] ($local_cfg["redistUrl"])
  platforms  = [json_object] ($local_cfg["platforms"])
  plat_cfg   = [json] ($platforms["$cc.target.cpu-$cc.target.class"])
  component  = [string] ($plat_cfg["component"])
  platform   = [string] ($plat_cfg["platform"])
  expected_v = [string] ($plat_cfg["version"])

  depdb hash $local_cfg
  diag curl $redistUrl -> $>

  curl -\# --fail "$redistUrl" | set redist [json]

  pkg_entry   = [json] ($redist["$component"])
  pkg_version = [string] ($pkg_entry["version"])
  if (!$contains($pkg_version, $expected_v))
  {
    echo "[error] version mismatch for $component/$platform: v$expected_v (local) != v$pkg_version (remote)" >&2
    exit 1
  }

  echo $json.serialize($redist) >$path($>)
}}

# Download platform-specific archive from NVIDIA CDN.
# $<[0]: json{$name-manifest} (redistrib JSON), $<[1]: manifest.json
archive{~'/(.+)/'}:
{{
  tar  = $out_root/$leaf($path($>))
  part = $(tar).part

  redist_j  = ($<[0])
  local_j   = ($<[1])
  redist    = [json] $json.load($path($redist_j))
  local_cfg = [json] $json.load($path($local_j))

  platforms  = [json_object] ($local_cfg["platforms"])
  plat_cfg   = [json] ($platforms["$cc.target.cpu-$cc.target.class"])
  component  = [string] ($plat_cfg["component"])
  platform   = [string] ($plat_cfg["platform"])

  pkg_entry  = [json] ($redist["$component"])
  plat_entry = [json] ($pkg_entry["$platform"])
  rel_path   = [string] ($plat_entry["relative_path"])

  redistUrl  = [string] ($local_cfg["redistUrl"])
  echo "$redistUrl" \
    | sed -n -e 's%/[^/]*$%%p' \
    | set base_url [string]
  url = "$(base_url)/$(rel_path)"

  depdb hash $redist
  diag curl $url -> $>

  bsdtar -tf $tar >- 2>&1 || \
    curl -\# --fail --output $part "$url"
  test -f $part && \
    rm -f $tar && mv $part $tar &!$tar || true
  test -f $path($>) || \
    ln --symbolic $tar $path($>)
  touch $path($>)
}}

# Extract archive into $out_base (strip the archive root directory).
extract{~'/(.+)/'}:
{{
  n = $name($>[0])
  o = $posix_representation($directory($>[0]))
  a = $posix_representation($path($<[0]))
  d = "$o$(n).files"

  pattern = [cmdline] \
    --exclude "*/bin/*32_*" \
    --exclude "*/lib/*32_*" \
    --exclude "*/lib32/*" \
    --exclude "*_lean_*" \
    --exclude "*samples*" \
    "*/*/*"  "*LICENSE"

  depdb dyndep \
    --dyn-target \
    --target-cwd "$o" \
    --target-what 'fetched binaries' \
    --target-default-type 'file' \
    --target-extension-type '=file' \
    --target-extension-type 'h=file' \
    --target-extension-type 'hpp=file' \
    --target-extension-type 'cuh=file' \
    --target-extension-type 'inl=file' \
    --target-extension-type 'a=file' \
    --target-extension-type 'so=file' \
    --target-extension-type 'dylib=file' \
    --target-extension-type 'dll=file' \
    --target-extension-type 'lib=file' \
    --target-extension-type 'exe=file' \
    --format lines \
    --file "$d" \
    -- \
      bsdtar -tf "$a" $pattern \
      | sed -n -e 's%^[^/]*/%%p' \
      | grep -v '/$' >$d

  diag bsdtar $< $filter_out($>, group)
  bsdtar -C "$o" -xmf "$a" --strip-components=1 $pattern
  touch $d
}}

# Linux: install versioned SONAME companions alongside the base .so.
# build2's default install only copies the base file. This also copies any
# real versioned binaries (e.g. libcudart.so.13.0.96) and recreates versioned
# symlinks (e.g. libcudart.so.13) pointing at the installed binary.
#
if ($cc.target.class != 'windows')
{
  libs{~'/lib(.+)/'}:
  % install
  {{
    dst = $install.resolve($install.lib, [dir_path])

    diag install $>

    mkdir --no-cleanup -p "$dst"

    for src : [paths] $path($>)
    {
      find "$directory($src)" -maxdepth 1 -name "$leaf($src).*" -type f \
        | set real_files [paths]
      find "$directory($src)" -maxdepth 1 -name "$leaf($src).*" -type l \
        | set sym_files [paths]

      if (!$empty($real_files))
      {
        real = $front($real_files)
        cp --no-cleanup "$real" "$dst/"
        rm -f "$dst/$leaf($src)"
        ln --no-cleanup -s "$leaf($real)" "$dst/$leaf($src)"
        for s : $sym_files
        {
          rm -f "$dst/$leaf($s)"
          ln --no-cleanup -s "$leaf($real)" "$dst/$leaf($s)"
        }
      }
      else
        cp --no-cleanup "$src" "$dst/"
    }
  }}
}
